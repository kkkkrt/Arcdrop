# ─────────────────────────────────────────────────────────────────────────────
# ArcDrop — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Required: address of your externally-deployed ArcDrop contract on Arc Testnet.
# Deploy the contract yourself and paste the address here.

# NEXT_PUBLIC_ prefix (Next.js / some hosting platforms):
NEXT_PUBLIC_ARCDROP_CONTRACT_ADDRESS=0xYourContractAddressHere

# Vite also needs a VITE_-prefixed alias so import.meta.env can read it:
VITE_ARCDROP_CONTRACT_ADDRESS=0xYourContractAddressHere

# Optional: Arc Testnet chain ID (defaults to 5042002 if not set).
# NEXT_PUBLIC_ARC_CHAIN_ID=5042002
# VITE_ARC_CHAIN_ID=5042002

# Legacy key (kept for backwards compatibility):
# VITE_ARC_DROP_ADDRESS=0xYourContractAddressHere
